# Required — provided out-of-band, never committed
OPENAI_API_KEY=
# Models / voice
THEA_LLM_MODEL=gpt-4o
THEA_TTS_VOICE=shimmer
# Audio (board ALSA device)
THEA_AUDIO_DEVICE=plughw:0,0
THEA_SILENCE_DURATION=2.5
THEA_LOCALE=en-US
# Run on real hardware (anything != "woz" takes the hardware path)
THEA_MODE=hardware
